# ---------------------------------------------------------------------------
# Task Studio PWA — environment
# Only VITE_-prefixed variables reach the browser. Never put a secret here:
# everything in this file ships inside the bundle.
# ---------------------------------------------------------------------------

# NestJS API, including the version prefix.
VITE_API_URL=http://localhost:3333/api/v1

# Socket.io origin (the API host without the /api/v1 path).
VITE_SOCKET_URL=http://localhost:3333
